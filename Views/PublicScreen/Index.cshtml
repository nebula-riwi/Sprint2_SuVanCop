@model SuVanCop.Models.ViewModels.PublicScreenViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SuVanCop</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SuVanCop.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;700;900&display=swap" rel="stylesheet">

    <style>
        body { background-color: #f0f4f8; font-family: 'Roboto', sans-serif; min-height: 100vh; }
        .container { max-width: 1200px; }
        .section-title { font-weight: 900; color: #007bff; letter-spacing: 2px; text-transform: uppercase; }
        .turn-card { border: none; border-radius: 1.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.15); background: linear-gradient(45deg,#007bff,#0056b3); color:white; transition: all 0.3s ease; }
        .turn-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.2); }
        .turn-number-display { font-size: 8rem; font-weight: 900; line-height:1; color:#ffc107; margin-bottom:0.5rem; }
        .appointment-card { border: 2px solid #ced4da; border-radius: 1rem; box-shadow:0 4px 15px rgba(0,0,0,0.05); transition: all 0.3s ease; }
        .appointment-detail { font-size:1.3rem; font-weight:700; color:#212529; margin-bottom:0.5rem; }
        .appointment-label { font-weight:300; color:#6c757d; }
        #startScreen { display:flex; justify-content:center; align-items:center; height:100vh; }
        #mainScreen { display:none; }
    </style>
</head>
<body>

<audio id="turnNotificationSound" src="/sounds/alert.mp3" preload="auto"></audio>

<div id="startScreen">
    <button id="startBtn" class="btn btn-primary btn-lg px-5 py-3">
        <i class="bi bi-bell-fill me-2"></i> Iniciar Turnero
    </button>
</div>

<div id="mainScreen" class="container py-5">
    <main role="main">
        <h2 class="text-center my-5 section-title display-4">
            <i class="bi bi-bell-fill me-3"></i> Turno Actual
        </h2>

        <div id="turns" class="row justify-content-center">
            <div class="col-lg-6 col-md-8 mb-5">
                <div class="card turn-card">
                    <div class="card-body text-center p-5" id="turnoActualizado">
                        @if (Model.CurrentTurn != null)
                        {
                        <p class="card-title mb-0 fs-3 fw-bold text-white opacity-75">
                            LLAMANDO
                        </p>
                        <div class="turn-number-display">
                            @Model.CurrentTurn.Type[0]@Model.CurrentTurn.Number
                        </div>
                        <p class="card-text fs-2 fw-bold text-light">
                            <i class="bi bi-person-badge me-2"></i> Taquilla: 1
                        </p>
                        }
                        else
                        {
                        <div class="text-center alert alert-warning fs-4 fw-bold p-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> No hay más turnos disponibles.
                        </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <hr class="my-5">

        <h2 class="text-center my-5 section-title display-6">
            <i class="bi bi-calendar-check me-3"></i> Cita en Curso
        </h2>
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card appointment-card">
                    <div class="card-body p-4 text-center">
                        <div id="citaActualizada">
                            @if (Model.CurrentAppointment != null)
                            {
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="appointment-detail">
                                        <i class="bi bi-person-fill me-2 text-primary"></i>
                                        <span class="appointment-label">PACIENTE:</span>
                                        @Model.CurrentAppointment.User?.FullName
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="appointment-detail">
                                        <i class="bi bi-person-plus-fill me-2 text-info"></i>
                                        <span class="appointment-label">Doctor:</span>
                                        @Model.CurrentAppointment.Doctor?.FullName
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="appointment-detail">
                                        <i class="bi bi-building-fill me-2 text-success"></i>
                                        <span class="appointment-label">Consultorio:</span>
                                        1
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="appointment-detail">
                                        <i class="bi bi-clock-fill me-2 text-warning"></i>
                                        <span class="appointment-label">Hora:</span>
                                        @Model.CurrentAppointment.Hour.ToString("HH:mm")
                                    </div>
                                </div>
                            </div>
                            }
                            else
                            {
                            <div class="alert alert-warning text-center fs-5" role="alert">
                                <i class="bi bi-exclamation-circle-fill me-2"></i> No hay cita actual programada.
                            </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.0/signalr.min.js" crossorigin="anonymous"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    const turnSound = document.getElementById('turnNotificationSound');
    const startBtn = document.getElementById('startBtn');
    const startScreen = document.getElementById('startScreen');
    const mainScreen = document.getElementById('mainScreen');

    startBtn.addEventListener('click', function() {
        // Desbloquea el audio
        turnSound.play().then(()=>turnSound.pause()).catch(()=>{});
        startScreen.style.display = 'none';
        mainScreen.style.display = 'block';
    });

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/turnHub")
        .build();

    connection.start()
        .then(() => console.log("Conectado a SignalR (PublicScreen)"))
        .catch(err => console.error("Error conectando a SignalR:", err));

    connection.on("UpdateTurn", function (id, number, type) {
        if (turnSound && number > 0) {
            turnSound.play().catch(error => console.warn(error));
        }

        // 🎙️ Voz del turno
        if (number > 0) {
            const utterance = new SpeechSynthesisUtterance(`Turno ${type[0]} ${number}, a la taquilla uno`);
            utterance.lang = 'es-ES';
            speechSynthesis.speak(utterance);
        }

        const content = number > 0
            ? `<p class="card-title mb-0 fs-3 fw-bold text-white opacity-75">LLAMANDO</p>
               <div class="turn-number-display">${type[0]}${number}</div>
               <p class="card-text fs-2 fw-bold text-light"><i class="bi bi-person-badge me-2"></i> Taquilla: 1</p>`
            : `<div class="text-center alert alert-warning fs-4 fw-bold p-4">
                 <i class="bi bi-exclamation-triangle-fill me-2"></i> No hay más turnos disponibles.
               </div>`;

        $('#turnoActualizado').fadeOut(400, function () {
            $(this).html(content).fadeIn(400);
        });
    });

    connection.on("UpdateAppointment", function (patientName, doctorName, office) {
        const appointmentContent = `<div class="row g-3">
            <div class="col-12">
                <div class="appointment-detail"><i class="bi bi-person-fill me-2 text-primary"></i>
                    <span class="appointment-label">PACIENTE:</span> ${patientName}
                </div>
            </div>
            <div class="col-md-4">
                <div class="appointment-detail"><i class="bi bi-person-plus-fill me-2 text-info"></i>
                    <span class="appointment-label">Doctor:</span> ${doctorName}
                </div>
            </div>
            <div class="col-md-4">
                <div class="appointment-detail"><i class="bi bi-building-fill me-2 text-success"></i>
                    <span class="appointment-label">Consultorio:</span> ${office}
                </div>
            </div>
            <div class="col-md-4">
                <div class="appointment-detail"><i class="bi bi-clock-fill me-2 text-warning"></i>
                    <span class="appointment-label">Hora:</span> N/A
                </div>
            </div>
        </div>`;

        $('#citaActualizada').fadeOut(400, function () {
            $(this).html(appointmentContent).fadeIn(400);
        });
    });
</script>
</body>
</html>
